# نمونه متغیرهای محیطی — این فایل را به .env کپی و مقادیر واقعی را وارد کنید.
# روی Render این مقادیر را در Environment Variables وب‌سرویس وارد کنید (نه در مخزن گیت).
BOT_TOKEN=123456:ABC-EXAMPLE-DO-NOT-SHARE
OWNER_ID=100000000

# شناسه عددی سوپرگروه (اختیاری؛ با دستور /group_id در گروه هم قابل استخراج است)
GROUP_ID=-1001234567890

# شناسه‌ی هفت موضوع = شناسه‌ی «پیام ریشه» هر تاپیک (Message Thread ID)
# با دستور /topic_id داخل هر موضوع، شناسه‌ی آن را بگیرید و اینجا وارد کنید.
# اگر مقدار نداشته باشد، ربات آن موضوع را «تنظیم‌نشده» می‌داند و محدودیتش را اعمال نمی‌کند.
TOPIC_GENERAL=
TOPIC_PODCAST=
TOPIC_RULES=
TOPIC_PORTFOLIO=
TOPIC_INTRO=
TOPIC_TARIFF=
TOPIC_PROJECTS=

# مسیر پایگاه داده و فایل الفاظ ممنوعه (پیش‌فرض همین‌ها)
DB_PATH=/tmp/bot_data.db
BANNED_WORDS_PATH=banned_words.txt
