# الگوی محیط محلی؛ مقادیر محرمانه/شناسه‌های واقعی خود را وارد کنید.
BOT_TOKEN=
OWNER_ID=
GROUP_ID=

# شناسهٔ message_thread_id هر موضوع؛ ترتیب و نام دقیق گروه:
TOPIC_1=1   # گفت‌وگوی عمومی گویندگان
TOPIC_2=213 # پادکست؛ تولید و تدوین
TOPIC_3=14  # قوانین و اطلاعیه‌ها
TOPIC_4=3   # نمونه‌کارهای گویندگی
TOPIC_5=66  # معرفی گویندگان حرفه‌ای
TOPIC_6=72  # تعرفه‌ها و قراردادهای گویندگی
TOPIC_7=4   # پروژه‌ها و درخواست‌های همکاری
TOPIC_8=473 # نقد و بررسی کارهای گویندگی
TOPIC_9=488 # ویرایش و بهینه‌سازی صدا

# نام‌های معنایی قدیمی (اختیاری؛ فقط وقتی TOPIC_1..TOPIC_9 متناظر خالی باشند):
# TOPIC_GENERAL=  # گفت‌وگوی عمومی گویندگان
# TOPIC_PODCAST=  # پادکست؛ تولید و تدوین
# TOPIC_RULES=    # قوانین و اطلاعیه‌ها
# TOPIC_PORTFOLIO=# نمونه‌کارهای گویندگی
# TOPIC_INTRO=    # معرفی گویندگان حرفه‌ای
# TOPIC_TARIFF=   # تعرفه‌ها و قراردادهای گویندگی
# TOPIC_PROJECTS= # پروژه‌ها و درخواست‌های همکاری
# TOPIC_REVIEWS=  # نقد و بررسی کارهای گویندگی
# TOPIC_AUDIO=    # ویرایش و بهینه‌سازی صدا

# سقف پیام کاربران معمولی در گفت‌وگوی عمومی (TOPIC_1) در هر ساعت:
RATE_LIMIT_GENERAL_PER_HOUR=10

DB_PATH=/tmp/bot_data.db
BANNED_WORDS_PATH=banned_words.txt
